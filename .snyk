# Snyk (https://snyk.io) policy file

version: v1.25.0

# Ignore specific vulnerabilities (add exceptions here with justification)
# Example:
# ignore:
#   SNYK-JS-MINIMIST-559764:
#     - '*':
#         reason: 'Dev dependency only, not exploitable in our use case'
#         expires: '2025-12-31T00:00:00.000Z'

# Patch directives
patch: {}

# Language-specific settings
language-settings:
  python:
    # Exclude dev dependencies from Python scans
    exclude-dev-dependencies: false

# Exclude patterns (similar to .gitignore)
exclude:
  global:
    - node_modules/**
    - dist/**
    - build/**
    - coverage/**
    - .next/**
    - '**/*.test.ts'
    - '**/*.spec.ts'
    - '**/test/**'
    - '**/tests/**'
    - documentation_guide/**