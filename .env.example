# Anthropic API
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-api-key-here

# Where the engine sends Claude requests (and the key). Defaults to the
# official API. The engine ignores the SDK's ANTHROPIC_BASE_URL, which a host
# or tool may set for its own use; only this setting moves the endpoint. It
# must be an https URL with a host and no credentials.
ENGINE_API_BASE_URL=https://api.anthropic.com

# Database
# Local development uses Docker Compose PostgreSQL
DATABASE_URL=postgresql://dev:devpass@localhost:5432/ai_platform

# Redis
# Local development uses Docker Compose Redis
REDIS_URL=redis://localhost:6379

# Qdrant
# Local development uses Docker Compose Qdrant
QDRANT_URL=http://localhost:6333

# Node Environment
NODE_ENV=development
