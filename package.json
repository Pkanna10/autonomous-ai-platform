{
  "name": "autonomous-ai-platform",
  "version": "1.0.0",
  "description": "Autonomous AI development platform combining AI agents, research paper integration, and self-improving systems",
  "type": "module",
  "main": "index.js",
  "keywords": [
    "ai",
    "autonomous",
    "langgraph",
    "claude",
    "anthropic",
    "research",
    "code-generation",
    "ai-agents",
    "machine-learning",
    "arxiv",
    "typescript",
    "python"
  ],
  "author": "Praveen Kanna",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pkanna10/autonomous-ai-platform.git"
  },
  "bugs": {
    "url": "https://github.com/Pkanna10/autonomous-ai-platform/issues"
  },
  "homepage": "https://github.com/Pkanna10/autonomous-ai-platform#readme",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.20.0"
  },
  "scripts": {
    "dev": "pnpm --filter agent-core dev",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "build": "pnpm --filter \"./packages/*\" build",
    "clean": "rm -rf node_modules dist build coverage && pnpm --filter \"./packages/*\" exec rm -rf node_modules dist build",
    "pre-commit": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:coverage",
    "prepare": "husky install",
    "validate": "pnpm run /^validate:.*/",
    "validate:format": "prettier --check .",
    "validate:lint": "eslint .",
    "validate:types": "tsc --noEmit",
    "validate:test": "vitest run"
  },
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/node": "^24.9.2",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitest/coverage-v8": "^4.0.6",
    "@vitest/ui": "^4.0.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
