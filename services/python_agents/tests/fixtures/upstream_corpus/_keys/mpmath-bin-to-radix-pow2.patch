 def bin_to_radix(x, xbits, base, bdigits):
     """Changes radix of a fixed-point number; i.e., converts
     x * 2**xbits to floor(x * base**bdigits)."""
+    # For power-of-two bases, base**bdigits is itself a power of two, so the
