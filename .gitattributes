# Git Attributes - Line Ending Configuration
# https://git-scm.com/docs/gitattributes

# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Python files
*.py text eol=lf

# Shell scripts
*.sh text eol=lf

# Configuration files
*.config.js text eol=lf
*.config.ts text eol=lf
.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.dockerignore text eol=lf
.prettierignore text eol=lf
.prettierrc* text eol=lf
.editorconfig text eol=lf
.npmrc text eol=lf

# SQL files
*.sql text eol=lf

# Documentation
*.txt text eol=lf
README text eol=lf
LICENSE text eol=lf
CHANGELOG text eol=lf

# Docker files
Dockerfile* text eol=lf
docker-compose*.yml text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.7z binary
*.bz2 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
