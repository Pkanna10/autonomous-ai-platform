# pnpm Configuration

# Use strict peer dependencies
strict-peer-dependencies=false

# Hoist dependencies to root
shamefully-hoist=false
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*typescript*
public-hoist-pattern[]=*vitest*

# Auto install peers
auto-install-peers=true

# Engine strict (enforce Node version)
engine-strict=true

# Save exact versions (no ^ or ~)
save-exact=false

# Prefer offline mode
prefer-offline=true

# Node linker
node-linker=isolated

# Lockfile
lockfile=true

# Store directory (default: ~/.pnpm-store)
# store-dir=~/.pnpm-store

# Registry (use default npm registry)
# registry=https://registry.npmjs.org/

# Enable workspace protocol
link-workspace-packages=true
