{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Dormant until the Renovate app is installed on the repository; .github/dependabot.yml covers version updates until then. Run one of the two, not both.",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":enableVulnerabilityAlertsWithLabel(security)",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    "group:monorepos",
    "schedule:earlyMondays",
    ":preserveSemverRanges"
  ],
  "timezone": "America/Los_Angeles",
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "packageRules": [
    {
      "description": "Group TypeScript dependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "groupName": "TypeScript dependencies",
      "rangeStrategy": "bump"
    },
    {
      "description": "Group Python dependencies (pyproject.toml, uv.lock)",
      "matchManagers": ["pep621"],
      "groupName": "Python dependencies",
      "rangeStrategy": "bump"
    },
    {
      "description": "Security vulnerability updates (HIGH priority)",
      "matchDatasources": ["npm", "pypi"],
      "prPriority": 10,
      "schedule": ["at any time"]
    },
    {
      "description": "Container images: tag and digest bumped together",
      "matchDatasources": ["docker"],
      "commitMessagePrefix": "build(docker):",
      "labels": ["docker", "dependencies"]
    },
    {
      "description": "GitHub Actions: SHA pins and their version comments",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "commitMessagePrefix": "ci:"
    },
    {
      "description": "Group ESLint packages",
      "groupName": "ESLint packages",
      "matchPackageNames": ["/^eslint/", "/^@typescript-eslint\\//"]
    },
    {
      "description": "Group Vitest packages",
      "groupName": "Vitest packages",
      "matchPackageNames": ["/^vitest/", "/^@vitest\\//"]
    },
    {
      "description": "Group Prettier packages",
      "groupName": "Prettier packages",
      "matchPackageNames": ["/^prettier/", "/^eslint-.*-prettier/"]
    },
    {
      "description": "Group Commitlint packages",
      "groupName": "Commitlint packages",
      "matchPackageNames": ["/^@commitlint\\//"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "addLabels": ["priority-high"],
    "schedule": ["at any time"],
    "prPriority": 10
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on the first day of the month"]
  },
  "schedule": ["before 3am on Monday"],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "🔄 Dependency Updates Dashboard",
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "prTitle": "{{commitMessagePrefix}} {{commitMessageAction}} {{commitMessageTopic}} to {{#if isMajor}}v{{newMajor}}{{else}}{{#if isSingleVersion}}{{newVersion}}{{else}}{{newValue}}{{/if}}{{/if}}",
  "rebaseWhen": "behind-base-branch",
  "stopUpdatingLabel": "no-renovate"
}
