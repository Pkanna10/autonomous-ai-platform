{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":dependencyDashboard",
    ":semanticCommits",
    ":enableVulnerabilityAlertsWithLabel(security)",
    "group:monorepos",
    "schedule:earlyMondays",
    ":preserveSemverRanges"
  ],
  "timezone": "America/Los_Angeles",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "packageRules": [
    {
      "description": "Auto-merge security patches",
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0/",
      "matchPackagePatterns": ["*"],
      "labels": ["dependencies", "security"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group TypeScript dependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "groupName": "TypeScript dependencies",
      "rangeStrategy": "bump"
    },
    {
      "description": "Group Python dependencies",
      "matchManagers": ["pip_requirements"],
      "groupName": "Python dependencies",
      "rangeStrategy": "bump"
    },
    {
      "description": "Automerge patch updates",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    },
    {
      "description": "Automerge dev dependencies (minor)",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Prioritize security updates",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["patch"],
      "vulnerabilityAlerts": {
        "labels": ["security", "priority-high"],
        "automerge": true,
        "schedule": ["at any time"]
      }
    },
    {
      "description": "Security vulnerability updates (HIGH priority)",
      "matchDatasources": ["npm", "pypi"],
      "prPriority": 10,
      "schedule": ["at any time"]
    },
    {
      "description": "Docker base images",
      "matchDatasources": ["docker"],
      "enabled": true,
      "commitMessagePrefix": "chore(docker):",
      "labels": ["docker", "dependencies"]
    },
    {
      "description": "Group ESLint packages",
      "groupName": "ESLint packages",
      "matchPackagePatterns": ["^eslint", "^@typescript-eslint/"]
    },
    {
      "description": "Group Vitest packages",
      "groupName": "Vitest packages",
      "matchPackagePatterns": ["^vitest", "^@vitest/"]
    },
    {
      "description": "Group Prettier packages",
      "groupName": "Prettier packages",
      "matchPackagePatterns": ["^prettier", "^eslint-.*-prettier"]
    },
    {
      "description": "Group Commitlint packages",
      "groupName": "Commitlint packages",
      "matchPackagePatterns": ["^@commitlint/"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "addLabels": ["priority-high"],
    "assignees": [],
    "schedule": ["at any time"],
    "prPriority": 10
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on the first day of the month"]
  },
  "schedule": ["before 3am on Monday"],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "🔄 Dependency Updates Dashboard",
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "prTitle": "{{commitMessagePrefix}} {{commitMessageAction}} {{commitMessageTopic}} to {{#if isMajor}}v{{newMajor}}{{else}}{{#if isSingleVersion}}{{newVersion}}{{else}}{{newValue}}{{/if}}{{/if}}",
  "rebaseWhen": "behind-base-branch",
  "stopUpdatingLabel": "no-renovate"
}
