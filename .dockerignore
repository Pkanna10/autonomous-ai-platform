# Git
.git
.gitignore
.gitattributes

# Dependencies
node_modules
pnpm-lock.yaml
package-lock.json
yarn.lock

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
env/
.venv/
*.egg-info/
*.egg
*.whl

# Environment & Secrets (CRITICAL: Never copy into images)
.env
.env.*
!.env.example
.env.vault

# Documentation (exclude from images, keep README for metadata)
*.md
!README.md
CLAUDE.md
STATUS.md
documentation_guide/

# Tests (no tests in production images)
**/*.test.ts
**/*.spec.ts
**/*.test.py
**/*_test.py
test/
tests/
__tests__/
coverage/
.coverage
htmlcov/
.pytest_cache/
*.cover

# Development files
.vscode/
*.code-workspace
.idea/
*.log
*.swp
*.swo
*~
.editorconfig
eslint.config.js
.prettierrc.json
.prettierignore
.lintstagedrc.json
commitlint.config.ts
renovate.json
vitest.config.ts
.nvmrc
.npmrc
tsconfig.json
tsconfig.*.json
packages/*/tsconfig.json

# Git hooks
.husky/

# Cache directories
.eslintcache
.vitest/
.pnpm-store/
.yarn/
.turbo/
.nyc_output/
.mypy_cache/
.ruff_cache/
.tox/

# Build artifacts
dist/
build/
.next/
out/
*.tsbuildinfo

# Docker (don't copy Docker files into Docker images)
docker-compose*.yml
Dockerfile*
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# OS files
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.backup

# Monitoring & logs (generated at runtime)
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Database files (use volumes, not copied files)
*.sql
*.db
*.sqlite
*.sqlite3
infrastructure/schema/

# Lock files (install from package.json instead)
pnpm-lock.yaml
package-lock.json
