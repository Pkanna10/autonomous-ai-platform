+
+_ZERO_WIDTH_OPS = tuple(
+    getattr(_sre_parse, name) for name in ('ASSERT', 'ASSERT_NOT', 'AT')
+    if hasattr(_sre_parse, name))
+_REPEAT_OPS = tuple(
+    getattr(_sre_parse, name)
+    for name in ('MAX_REPEAT', 'MIN_REPEAT', 'POSSESSIVE_REPEAT')
+    if hasattr(_sre_parse, name))
+_ATOMIC_OP = getattr(_sre_parse, 'ATOMIC_GROUP', None)
