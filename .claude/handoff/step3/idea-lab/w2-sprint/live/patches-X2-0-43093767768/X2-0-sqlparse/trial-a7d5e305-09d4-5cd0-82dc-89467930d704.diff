+
+def _analyse(rexmatch):
+    """Return (tests, ignorecase) or None if pattern can't be analysed."""
+    try:
+        pattern = rexmatch.__self__
+        if not isinstance(pattern, re.Pattern) or \
+                not isinstance(pattern.pattern, str):
+            return None
+        flags = pattern.flags
+        if flags & re.LOCALE:
+            return None
+        parsed = _sre_parse.parse(pattern.pattern, flags)
+        out = []
+        if _first_seq(list(parsed), out):
+            return None  # may match empty string
+        return out, bool(flags & re.IGNORECASE)
+    except Exception:
+        return None
+
+
+def _lit(v, c, ic):
+    """Tri-state: does literal code point v match ASCII char c?"""
+    if v < 128:
+        if ic:
+            return chr(v).lower() == c.lower()
+        return chr(v) == c
+    if ic and v in _FOLD_SPECIALS:
+        return None
+    return False
+
+
+def _range(lo, hi, c, ic):
+    if ic:
+        variants = (ord(c), ord(c.lower()), ord(c.upper()))
+    else:
+        variants = (ord(c),)
+    for o in variants:
+        if lo <= o <= hi:
+            return True
+    if ic and hi >= 128:
+        for s in _FOLD_SPECIALS:
+            if lo <= s <= hi:
+                return None
+    return False
+
+
+def _in(items, c, ic):
+    P = _sre_parse
+    negate = False
+    result = False
+    for op, av in items:
+        if op is P.NEGATE:
+            negate = True
+            continue
+        if op is P.LITERAL:
+            r = _lit(av, c, ic)
+        elif op is P.RANGE:
+            r = _range(av[0], av[1], c, ic)
+        elif op is P.CATEGORY:
+            fn = _CATEGORY_RX.get(getattr(av, 'name', None))
+            r = None if fn is None else bool(fn(c))
+        else:
+            r = None
+        if r:
+            result = True
+            break
+        if r is None:
+            result = None
+    if result is None:
+        return None
+    return (not result) if negate else result
+
+
+def _may_start_with(analysis, c):
+    tests, ic = analysis
+    P = _sre_parse
+    for op, av in tests:
+        if op is P.LITERAL:
+            r = _lit(av, c, ic)
+        elif op is P.NOT_LITERAL:
+            r = _lit(av, c, ic)
+            r = None if r is None else not r
+        else:
+            r = _in(av, c, ic)
+        if r is None or r:
+            return True
+    return False
+
 
