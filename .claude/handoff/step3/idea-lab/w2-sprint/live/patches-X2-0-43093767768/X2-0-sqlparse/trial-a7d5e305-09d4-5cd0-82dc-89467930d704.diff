+
+def _first_seq(items, out):
+    """Collect first-char tests of a sequence; return True if nullable."""
+    for op, av in items:
+        if not _first_item(op, av, out):
+            return False
+    return True
+
+
+def _first_item(op, av, out):
+    """Collect first-char tests of one node; return True if nullable."""
+    P = _sre_parse
+    if op is P.LITERAL or op is P.NOT_LITERAL or op is P.IN:
+        out.append((op, av))
+        return False
+    if op in _ZERO_WIDTH_OPS:
+        return True
+    if op is P.SUBPATTERN:
+        add_flags, del_flags, sub = av[1], av[2], av[3]
+        if add_flags or del_flags:
+            raise _Unanalysable
+        return _first_seq(sub, out)
+    if _ATOMIC_OP is not None and op is _ATOMIC_OP:
+        return _first_seq(av, out)
+    if op is P.BRANCH:
+        nullable = False
+        for alt in av[1]:
+            if _first_seq(alt, out):
+                nullable = True
+        return nullable
+    if op in _REPEAT_OPS:
+        lo, _hi, sub = av
+        sub_nullable = _first_seq(sub, out)
+        return lo == 0 or sub_nullable
+    raise _Unanalysable
