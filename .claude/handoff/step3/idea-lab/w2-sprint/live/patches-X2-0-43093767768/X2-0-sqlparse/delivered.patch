+def _within_limits(tlist):
+    """Return True if no grouping pass could hit the depth/token limits."""
+    max_depth = MAX_GROUPING_DEPTH
+    max_tokens = MAX_GROUPING_TOKENS
+    stack = [(tlist, 0)]
+    pop = stack.pop
+    push = stack.append
+    while stack:
+        grp, depth = pop()
+        if max_depth is not None and depth > max_depth:
+            return False
+        tokens = grp.tokens
+        if max_tokens is not None and len(tokens) > max_tokens:
+            return False
+        for tok in tokens:
+            if tok.is_group:
+                push((tok, depth + 1))
+    return True
+
+
+def _leaf_triggers(stmt):
+    """Collect which optional passes have a trigger leaf in the statement."""
+    checks = [
+        ('brackets', lambda t: t.match(*sql.SquareBrackets.M_OPEN)),
+        ('case', lambda t: t.match(*sql.Case.M_OPEN)),
+        ('if', lambda t: t.match(*sql.If.M_OPEN)),
+        ('for', lambda t: t.match(*sql.For.M_OPEN)),
+        ('begin', lambda t: t.match(*sql.Begin.M_OPEN)),
+        ('typecasts', lambda t: t.match(T.Punctuation, '::')),
+        ('tzcasts', lambda t: t.ttype == T.Keyword.TZCast),
+        ('typed_literal', lambda t: imt(t, m=sql.TypedLiteral.M_OPEN)),
+        ('assignment', lambda t: t.match(T.Assignment, ':=')),
+    ]
+    found = set()
+    for leaf in stmt.flatten():
+        if leaf.is_whitespace:
+            continue
+        remaining = []
+        for name, check in checks:
+            if check(leaf):
+                found.add(name)
+            else:
+                remaining.append((name, check))
+        if not remaining:
+            break
+        checks = remaining
+    return found
