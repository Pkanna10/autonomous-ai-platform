+_ARR_WS: Final = r"[ \t\n]*"
+_ARR_INT: Final = r"[+-]?(?:0|[1-9][0-9]*)"
+_ARR_STR: Final = (
+    r'"[^"\\\x00-\x08\x0a-\x1f\x7f]*"' r"|'[^'\x00-\x08\x0a-\x1f\x7f]*'"
