     def set_SQL_REGEX(self, SQL_REGEX):
         """Set the list of regex that will parse the SQL."""
         FLAGS = re.IGNORECASE | re.UNICODE
+        SQL_REGEX = list(SQL_REGEX)
         self._SQL_REGEX = [
             (re.compile(rx, FLAGS).match, tt)
             for rx, tt in SQL_REGEX
         ]
+        self._combined_match, self._group_actions = \
+            self._build_combined(SQL_REGEX, FLAGS)
+        # The combined regex is only valid for this exact list object.
+        self._combined_for = self._SQL_REGEX
+
+    @staticmethod
+    def _shift_backrefs(rx, offset):
+        """Renumber numeric backreferences in ``rx`` by ``offset``.
+        Returns None if the pattern cannot be safely rewritten."""
+        out = []
+        i = 0
+        n = len(rx)
+        in_class = False
+        while i < n:
+            c = rx[i]
+            if c == '\\':
+                if i + 1 >= n:
+                    return None
+                nxt = rx[i + 1]
+                if nxt.isdigit() and not in_class:
+                    if nxt == '0' or (i + 2 < n and rx[i + 2].isdigit()):
+                        return None
+                    out.append('(?:\\' + str(int(nxt) + offset) + ')')
+                else:
+                    out.append(c + nxt)
+                i += 2
+                continue
+            if in_class:
+                if c == ']':
+                    in_class = False
+            elif c == '[':
+                in_class = True
+                out.append(c)
+                i += 1
+                # a leading ']' (optionally after '^') is literal
+                if i < n and rx[i] == '^':
+                    out.append('^')
+                    i += 1
+                if i < n and rx[i] == ']':
+                    out.append(']')
+                    i += 1
+                continue
+            out.append(c)
+            i += 1
+        if in_class:
+            return None
+        return ''.join(out)
+
+    @classmethod
+    def _build_combined(cls, SQL_REGEX, FLAGS):
+        """Build one alternation regex of all patterns. Returns
+        (match, actions) where actions maps the outer group index to the
+        action, or (None, None) if combination is unsafe."""
+        if not SQL_REGEX:
+            return None, None
+        parts = []
+        actions = {}
+        group = 0
+        try:
+            for rx, tt in SQL_REGEX:
+                if not isinstance(rx, str):
+                    return None, None
+                if '(?(' in rx or re.search(r'\(\?[aiLmsux]+\)', rx):
+                    return None, None
+                ngroups = re.compile(rx, FLAGS).groups
+                group += 1
+                shifted = cls._shift_backrefs(rx, group)
+                if shifted is None:
+                    return None, None
+                actions[group] = tt
+                parts.append('(' + shifted + ')')
+                group += ngroups
+            combined = re.compile('|'.join(parts), FLAGS)
+        except (re.error, TypeError, ValueError):
+            return None, None
+        if combined.groups != group:
+            return None, None
+        return combined.match, actions
 
