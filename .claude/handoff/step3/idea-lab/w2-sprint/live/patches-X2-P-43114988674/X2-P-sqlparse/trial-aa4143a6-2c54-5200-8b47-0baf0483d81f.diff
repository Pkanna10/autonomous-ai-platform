+
+_ASCII = [chr(i) for i in range(128)]
+
+
+class _Unknown(Exception):
+    pass
+
+
+def _fold(chars):
+    out = set()
+    for c in chars:
+        out.add(c)
+        out.add(c.lower())
+        out.add(c.upper())
+    return {c for c in out if len(c) == 1 and ord(c) < 128}
+
+
+_CATEGORY_RX = {}
+for _name, _rx in (('CATEGORY_DIGIT', r'\d'), ('CATEGORY_WORD', r'\w'),
+                   ('CATEGORY_SPACE', r'\s')):
+    _op = getattr(_sre_c, _name, None)
+    if _op is not None:
+        _CATEGORY_RX[_op] = _rx
+
+
+def _category_set(cat, flags):
+    rx = _CATEGORY_RX.get(cat)
+    if rx is None:
+        raise _Unknown
+    m = re.compile(rx, flags).match
+    return {c for c in _ASCII if m(c)}
+
+
+def _in_set(items, flags):
+    result = set()
+    for op, av in items:
+        if op is _sre_c.LITERAL:
+            if av >= 128:
+                raise _Unknown
+            result |= _fold(chr(av))
+        elif op is _sre_c.RANGE:
+            lo, hi = av
+            if hi >= 128:
+                raise _Unknown
+            result |= _fold(chr(i) for i in range(lo, hi + 1))
+        elif op is _sre_c.CATEGORY:
+            result |= _category_set(av, flags)
+        else:
+            raise _Unknown
+    return result
+
+
+def _seq_first(seq, flags):
+    """Return (set of possible ASCII first chars, nullable)."""
+    result = set()
+    for op, av in seq:
+        first, nullable = _item_first(op, av, flags)
+        result |= first
+        if not nullable:
+            return result, False
+    return result, True
+
+
+def _item_first(op, av, flags):
+    c = _sre_c
+    if op is c.LITERAL:
+        if av >= 128:
+            raise _Unknown
+        return _fold(chr(av)), False
+    if op is c.IN:
+        return _in_set(av, flags), False
+    if op is c.SUBPATTERN:
+        return _seq_first(av[-1], flags)
+    if op in (c.MAX_REPEAT, c.MIN_REPEAT) or \
+            op is getattr(c, 'POSSESSIVE_REPEAT', None):
+        lo, _hi, sub = av
+        first, nullable = _seq_first(sub, flags)
+        return first, nullable or lo == 0
+    if op is c.BRANCH:
+        result = set()
+        nullable = False
+        for alt in av[1]:
+            first, n = _seq_first(alt, flags)
+            result |= first
+            nullable = nullable or n
+        return result, nullable
+    if op is getattr(c, 'ATOMIC_GROUP', None):
+        return _seq_first(av, flags)
+    if op in (c.AT, c.ASSERT, c.ASSERT_NOT):
+        # zero-width; ignoring the restriction is conservative
+        return set(), True
+    raise _Unknown
+
+
+def _first_chars(rx, flags):
+    """Conservatively compute the set of ASCII characters a match of
+    ``rx`` may start with. Returns None if unknown (match anywhere)."""
+    if not isinstance(rx, str):
+        return None
+    try:
+        parsed = _sre_parse.parse(rx, flags)
+        first, nullable = _seq_first(parsed, flags)
+    except _Unknown:
+        return None
+    if nullable:
+        return None
+    return frozenset(first)
+
 
