+try:  # Python 3.11+
+    from re import _parser as _sre_parse
+except ImportError:  # pragma: no cover
+    import sre_parse as _sre_parse  # type: ignore
+
+_MAX_RANGE = 256
+
+
+def _seq_start_set(items) -> set | None:
+    """
+    Return the exact set of characters a match of the parsed sequence must
+    begin with, or `None` if this cannot be determined with certainty
+    (including when the sequence may match the empty string).
+    """
+    P = _sre_parse
+    for op, av in items:
+        if op is P.AT or op is P.ASSERT or op is P.ASSERT_NOT:
+            # Zero-width: skip.
+            continue
+        if op is P.LITERAL:
+            return {chr(av)}
+        if op is P.IN:
+            result = set()
+            for iop, iav in av:
+                if iop is P.LITERAL:
+                    result.add(chr(iav))
+                elif iop is P.RANGE:
+                    lo, hi = iav
+                    if hi - lo > _MAX_RANGE:
+                        return None
+                    result.update(chr(c) for c in range(lo, hi + 1))
+                else:
+                    return None
+            return result if result else None
+        if op is P.SUBPATTERN:
+            if len(av) != 4:
+                return None
+            group, add_flags, del_flags, sub = av
+            if add_flags or del_flags:
+                return None
+            return _seq_start_set(list(sub))
+        if op is P.BRANCH:
+            result = set()
+            for branch in av[1]:
+                s = _seq_start_set(list(branch))
+                if s is None:
+                    return None
+                result |= s
+            return result if result else None
+        if op is P.MAX_REPEAT or op is P.MIN_REPEAT:
+            lo, hi, sub = av
+            if lo < 1:
+                return None
+            return _seq_start_set(list(sub))
+        return None
+    # Sequence may match empty string.
+    return None
+
+
+def _pattern_start_set(pattern: object) -> frozenset | None:
+    """ Compute the first-character set for an inline pattern, or `None`. """
+    try:
+        if not isinstance(pattern, inlinepatterns.InlineProcessor):
+            return None
+        if type(pattern).getCompiledRegExp is not inlinepatterns.Pattern.getCompiledRegExp:
+            return None
+        regex = pattern.compiled_re
+        if not isinstance(regex, re.Pattern) or not isinstance(regex.pattern, str):
+            return None
+        if regex.flags & re.IGNORECASE:
+            return None
+        parsed = _sre_parse.parse(regex.pattern, regex.flags)
+        s = _seq_start_set(list(parsed))
+        return frozenset(s) if s else None
+    except Exception:  # pragma: no cover
+        return None
