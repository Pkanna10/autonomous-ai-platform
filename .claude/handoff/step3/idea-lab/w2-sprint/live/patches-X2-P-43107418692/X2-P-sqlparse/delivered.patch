+def _first_nodes(seq, out):
+    """Collect single-character nodes that may start a match of seq.
+
+    Returns True if seq may match the empty string. Raises _Unknown if
+    the start cannot be determined. Over-approximates the start set.
+    """
+    P = _sre_parse
+    single = (P.LITERAL, P.NOT_LITERAL, P.IN, P.ANY)
+    repeats = tuple(getattr(P, name) for name in
+                    ('MAX_REPEAT', 'MIN_REPEAT', 'POSSESSIVE_REPEAT')
+                    if hasattr(P, name))
+    zero_width = (P.AT, P.ASSERT, P.ASSERT_NOT)
+    atomic = getattr(P, 'ATOMIC_GROUP', None)
+    for op, av in seq:
+        if op in single:
+            out.append((op, av))
+            return False
+        elif op in zero_width:
+            continue
+        elif op is P.SUBPATTERN:
+            if len(av) != 4 or av[1] or av[2]:
+                raise _Unknown
+            if not _first_nodes(av[3], out):
+                return False
+        elif op is P.BRANCH:
+            nullable = False
+            for alt in av[1]:
+                if _first_nodes(alt, out):
+                    nullable = True
+            if not nullable:
+                return False
+        elif op in repeats:
+            min_, _max, sub = av
+            if not _first_nodes(sub, out) and min_ > 0:
+                return False
+        elif atomic is not None and op is atomic:
+            if not _first_nodes(av, out):
+                return False
+        else:
+            raise _Unknown
+    return True
+
