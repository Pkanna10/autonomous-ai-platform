+    @staticmethod
+    def _shift_backrefs(rx, offset):
+        """Shift numbered backreferences in ``rx`` by ``offset``.
+        Returns None if the pattern cannot be safely rewritten."""
+        out = []
+        i = 0
+        n = len(rx)
+        in_class = False
+        while i < n:
+            c = rx[i]
+            if c == '\\':
+                if i + 1 >= n:
+                    return None
+                nxt = rx[i + 1]
+                if not in_class and nxt in '123456789':
+                    j = i + 1
+                    while j < n and j < i + 3 and rx[j].isdigit():
+                        j += 1
+                    if j < n and rx[j].isdigit():
+                        return None  # possible octal escape
+                    num = int(rx[i + 1:j]) + offset
+                    if num >= 100:
+                        return None
+                    out.append('(?:\\%d)' % num)
+                    i = j
+                    continue
+                if nxt == 'g' or nxt == '0':
+                    return None
+                out.append(rx[i:i + 2])
+                i += 2
+                continue
+            if in_class:
+                if c == ']':
+                    in_class = False
+            elif c == '[':
+                in_class = True
+                out.append(c)
+                i += 1
+                # a ']' (optionally after '^') right after '[' is literal
+                if i < n and rx[i] == '^':
+                    out.append('^')
+                    i += 1
+                if i < n and rx[i] == ']':
+                    out.append(']')
+                    i += 1
+                continue
+            elif c == '(' and rx.startswith('(?P=', i):
+                return None
+            out.append(c)
+            i += 1
+        return ''.join(out)
+
+    @classmethod
+    def _build_master(cls, SQL_REGEX, flags):
+        parts = []
+        actions = {}
+        group_count = 0
+        for idx, (rx, tt) in enumerate(SQL_REGEX):
+            if '(?P' in rx or rx.lstrip().startswith('(?') and \
+                    re.match(r'\(\?[aiLmsux]+\)', rx):
+                return None
+            compiled = re.compile(rx, flags)
+            if compiled.groupindex:
+                return None
+            group_count += 1  # the wrapper group
+            shifted = cls._shift_backrefs(rx, group_count)
+            if shifted is None:
+                return None
+            name = 'g%d' % idx
+            parts.append('(?P<%s>%s)' % (name, shifted))
+            actions[name] = tt
+            group_count += compiled.groups
+        master = re.compile('|'.join(parts), flags)
+        if master.groups != group_count:
+            return None
+        return master.match, actions
 
