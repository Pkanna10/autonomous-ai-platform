+        self._dispatch_src = regex_list
+
+    def _candidates_for(self, char):
+        """Return (and cache) regexes that may match starting with char."""
+        candidates = []
+        for rexmatch, action, probes in self._dispatch_entries:
+            if probes is None:
+                candidates.append((rexmatch, action))
+                continue
+            for probe in probes:
+                if probe(char):
+                    candidates.append((rexmatch, action))
+                    break
+        candidates = tuple(candidates)
+        self._dispatch[char] = candidates
+        return candidates
