+    def _build_dispatch(self):
+        """Prepare the per-first-character candidate cache."""
+        regex_list = self._SQL_REGEX
+        entries = []
+        for rexmatch, action in regex_list:
+            entries.append((rexmatch, action, _first_char_probes(rexmatch)))
+        self._dispatch_entries = entries
