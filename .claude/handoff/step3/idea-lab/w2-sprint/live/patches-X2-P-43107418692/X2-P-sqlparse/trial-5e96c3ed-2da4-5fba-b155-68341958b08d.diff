+def _first_char_probes(rexmatch):
+    """Return a list of single-char match functions, any of which must
+    succeed for the regex to possibly match at a position starting with
+    that char; or None if the regex must always be tried."""
+    if _sre_parse is None:
+        return None
+    try:
+        pattern = rexmatch.__self__
+        parsed = _sre_parse.parse(pattern.pattern, pattern.flags)
+        nodes = []
+        if _first_nodes(parsed, nodes):
+            return None
+        state = getattr(parsed, 'state', None)
+        if state is None:
+            state = parsed.pattern
+        probes = []
+        for node in nodes:
+            sub = _sre_parse.SubPattern(state, [node])
+            probes.append(_sre_compile.compile(sub, pattern.flags).match)
+        return probes
+    except Exception:
+        return None
+
 
