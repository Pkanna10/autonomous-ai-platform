+    def __buildGatedPatterns(self) -> list[tuple[inlinepatterns.Pattern, tuple[str, ...] | None]]:
+        """ Build a list of `(pattern, required_literals)` in inline pattern order. """
+        default_get = inlinepatterns.Pattern.getCompiledRegExp
+        result = []
+        for i in range(len(self.inlinePatterns)):
+            pattern = self.inlinePatterns[i]
+            literals = None
+            if (
+                isinstance(pattern, inlinepatterns.InlineProcessor) and
+                getattr(type(pattern), 'getCompiledRegExp', None) is default_get
+            ):
+                compiled = getattr(pattern, 'compiled_re', None)
+                source = getattr(compiled, 'pattern', None)
+                if isinstance(source, str):
+                    literals = _REQUIRED_LITERALS.get(source)
+            result.append((pattern, literals))
+        return result
