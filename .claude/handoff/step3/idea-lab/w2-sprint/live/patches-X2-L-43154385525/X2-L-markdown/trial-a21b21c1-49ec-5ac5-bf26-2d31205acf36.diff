+    inlinepatterns.BACKTICK_RE: ('`',),
+    inlinepatterns.ESCAPE_RE: ('\\',),
+    inlinepatterns.LINK_RE: ('[',),
+    inlinepatterns.REFERENCE_RE: ('[',),
+    inlinepatterns.IMAGE_LINK_RE: ('![',),
+    inlinepatterns.IMAGE_REFERENCE_RE: ('![',),
+    inlinepatterns.AUTOLINK_RE: ('<',),
+    inlinepatterns.AUTOMAIL_RE: ('<',),
+    inlinepatterns.HTML_RE: ('<',),
+    inlinepatterns.ENTITY_RE: ('&',),
+    inlinepatterns.LINE_BREAK_RE: ('  \n',),
+    inlinepatterns.NOT_STRONG_RE: ('*', '_'),
+    r'\*': ('*',),
+    r'_': ('_',),
+}
+
