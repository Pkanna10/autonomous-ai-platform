+_KNOWN_TRIGGERS: dict[str, str] | None = None
+
+
+def _known_pattern_triggers() -> dict[str, str]:
+    """
+    Map built-in inline pattern regex strings to the characters at least one of
+    which must be present in the text for the regex to be able to match.
+    """
+    global _KNOWN_TRIGGERS
+    if _KNOWN_TRIGGERS is None:
+        ip = inlinepatterns
+        _KNOWN_TRIGGERS = {
+            ip.BACKTICK_RE: '`',
+            ip.ESCAPE_RE: '\\',
+            ip.LINK_RE: '[',
+            ip.IMAGE_LINK_RE: '[',
+            ip.AUTOLINK_RE: '<',
+            ip.AUTOMAIL_RE: '<',
+            ip.HTML_RE: '<',
+            ip.ENTITY_RE: '&',
+            ip.LINE_BREAK_RE: '\n',
+            ip.NOT_STRONG_RE: '*_',
+            r'\*': '*',
+            r'_': '_',
+        }
+    return _KNOWN_TRIGGERS
+
