@@ -86,6 +114,32 @@ class InlineProcessor(Treeprocessor):
         self.md = md
         self.inlinePatterns = md.inlinePatterns
         self.ancestors: list[str] = []
+        self._trigger_re: re.Pattern[str] | None = None
+
+    def _build_trigger_re(self) -> re.Pattern[str] | None:
+        """
+        Build a regex matching any character required by every registered
+        inline pattern. Returns `None` if any pattern is not a known built-in
+        regex (in which case no prefiltering is done).
+        """
+        known = _known_pattern_triggers()
+        chars: set[str] = set()
+        base_get = inlinepatterns.Pattern.getCompiledRegExp
+        for pattern in self.inlinePatterns:
+            if not isinstance(pattern, inlinepatterns.InlineProcessor):
+                return None
+            if getattr(type(pattern), 'getCompiledRegExp', None) is not base_get:
+                return None
+            compiled = getattr(pattern, 'compiled_re', None)
+            if compiled is None:
+                return None
+            trig = known.get(compiled.pattern)
+            if trig is None:
+                return None
+            chars.update(trig)
+        if not chars:
+            return None
+        return re.compile('[' + ''.join(re.escape(c) for c in sorted(chars)) + ']')
 
