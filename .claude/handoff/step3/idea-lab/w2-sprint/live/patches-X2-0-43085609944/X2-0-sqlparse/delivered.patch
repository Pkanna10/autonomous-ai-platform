+                    s = m.group(1)
+                    if not s.isdigit():
+                        return m.group(0)
+                    if s[0] == '0' or len(s) > 2 or int(s) > ngroups:
+                        ok[0] = False
+                        return m.group(0)
+                    return '\\%d' % (int(s) + wrapper)
+
+                new_rx = backref.sub(_renum, rx)
+                if not ok[0]:
+                    return None, None
+                parts.append('(' + new_rx + ')')
+                actions[wrapper] = tt
+                offset += ngroups + 1
+            master = re.compile('|'.join(parts), FLAGS)
+        except (re.error, OverflowError, AssertionError):
+            return None, None
+        if master.groups != offset:
+            return None, None
+        return master.match, actions
 
