+    @staticmethod
+    def _build_master(SQL_REGEX, FLAGS):
+        """Combine all rules into one ordered alternation.
+
+        Returns (match, actions) where actions maps the wrapper group index
+        to the rule's action, or (None, None) if combining is not safe."""
+        backref = re.compile(r'\\(\d+|.)', re.DOTALL)
+        parts = []
+        actions = {}
+        offset = 0
+        try:
+            for rx, tt in SQL_REGEX:
+                if not isinstance(rx, str):
+                    return None, None
+                ngroups = re.compile(rx, FLAGS).groups
+                if '(?P' in rx or re.search(r'\(\?[aiLmsux]+\)', rx):
+                    return None, None
+                wrapper = offset + 1
+                ok = [True]
+
+                def _renum(m, wrapper=wrapper, ngroups=ngroups, ok=ok):
+                    s = m.group(1)
+                    if not s.isdigit():
+                        return m.group(0)
+                    if s[0] == '0' or len(s) > 2 or int(s) > ngroups:
+                        ok[0] = False
+                        return m.group(0)
+                    return '\\%d' % (int(s) + wrapper)
+
+                new_rx = backref.sub(_renum, rx)
+                if not ok[0]:
+                    return None, None
+                parts.append('(' + new_rx + ')')
+                actions[wrapper] = tt
+                offset += ngroups + 1
+            master = re.compile('|'.join(parts), FLAGS)
+        except (re.error, OverflowError, AssertionError):
+            return None, None
+        if master.groups != offset:
+            return None, None
+        return master.match, actions
 
