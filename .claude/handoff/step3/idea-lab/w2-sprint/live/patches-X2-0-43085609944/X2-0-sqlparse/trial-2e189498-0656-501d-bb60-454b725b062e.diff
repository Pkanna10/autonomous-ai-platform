+def _prepare_match(spec):
+    """Turn a (ttype, values) pair into (ttype, raw_set, upper_set)."""
+    ttype, values = spec
+    if values is None:
+        return ttype, None, None
+    if isinstance(values, str):
+        values = (values,)
+    raw = frozenset(values)
+    return ttype, raw, frozenset(v.upper() for v in raw)
+
