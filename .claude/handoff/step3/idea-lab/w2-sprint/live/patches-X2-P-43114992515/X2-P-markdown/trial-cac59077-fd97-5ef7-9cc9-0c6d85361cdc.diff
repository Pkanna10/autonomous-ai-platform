+# Stock inline patterns (exact class, regex source). Every one of them needs at
+# least one character from `_INLINE_TRIGGER_RE` to match:
+#   backtick: "`" (or "\\"); escape: "\\"; (image) links/references: "[";
+#   autolink/automail/html: "<"; entity: "&"; linebreak: "\n";
+#   not_strong/em_strong: "*"; em_strong2: "_".
+_STOCK_INLINE_PATTERNS = frozenset([
+    (inlinepatterns.BacktickInlineProcessor, inlinepatterns.BACKTICK_RE),
+    (inlinepatterns.EscapeInlineProcessor, inlinepatterns.ESCAPE_RE),
+    (inlinepatterns.ReferenceInlineProcessor, inlinepatterns.REFERENCE_RE),
+    (inlinepatterns.LinkInlineProcessor, inlinepatterns.LINK_RE),
+    (inlinepatterns.ImageInlineProcessor, inlinepatterns.IMAGE_LINK_RE),
+    (inlinepatterns.ImageReferenceInlineProcessor, inlinepatterns.IMAGE_REFERENCE_RE),
+    (inlinepatterns.ShortReferenceInlineProcessor, inlinepatterns.REFERENCE_RE),
+    (inlinepatterns.ShortImageReferenceInlineProcessor, inlinepatterns.IMAGE_REFERENCE_RE),
+    (inlinepatterns.AutolinkInlineProcessor, inlinepatterns.AUTOLINK_RE),
+    (inlinepatterns.AutomailInlineProcessor, inlinepatterns.AUTOMAIL_RE),
+    (inlinepatterns.SubstituteTagInlineProcessor, inlinepatterns.LINE_BREAK_RE),
+    (inlinepatterns.HtmlInlineProcessor, inlinepatterns.HTML_RE),
+    (inlinepatterns.HtmlInlineProcessor, inlinepatterns.ENTITY_RE),
+    (inlinepatterns.SimpleTextInlineProcessor, inlinepatterns.NOT_STRONG_RE),
+    (inlinepatterns.AsteriskProcessor, r'\*'),
+    (inlinepatterns.UnderscoreProcessor, r'_'),
+])
+
+_INLINE_TRIGGER_RE = re.compile(r'[\\`\[<&*_\n!:@]')
+
+
 class Treeprocessor(util.Processor):
