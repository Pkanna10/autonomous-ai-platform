+# Characters at least one of which every default inline pattern requires.
+_INLINE_TRIGGER_RE = re.compile('[`\\\\*_\\[\\]!<>&\n~' + util.STX + util.ETX + ']')
+
+_DEFAULT_INLINE_SPEC = {
+    'backtick': (inlinepatterns.BacktickInlineProcessor, inlinepatterns.BACKTICK_RE),
+    'escape': (inlinepatterns.EscapeInlineProcessor, inlinepatterns.ESCAPE_RE),
+    'reference': (inlinepatterns.ReferenceInlineProcessor, inlinepatterns.REFERENCE_RE),
+    'link': (inlinepatterns.LinkInlineProcessor, inlinepatterns.LINK_RE),
+    'image_link': (inlinepatterns.ImageInlineProcessor, inlinepatterns.IMAGE_LINK_RE),
+    'image_reference': (inlinepatterns.ImageReferenceInlineProcessor, inlinepatterns.IMAGE_REFERENCE_RE),
+    'short_reference': (inlinepatterns.ShortReferenceInlineProcessor, inlinepatterns.REFERENCE_RE),
+    'short_image_ref': (inlinepatterns.ShortImageReferenceInlineProcessor, inlinepatterns.IMAGE_REFERENCE_RE),
+    'autolink': (inlinepatterns.AutolinkInlineProcessor, inlinepatterns.AUTOLINK_RE),
+    'automail': (inlinepatterns.AutomailInlineProcessor, inlinepatterns.AUTOMAIL_RE),
+    'linebreak': (inlinepatterns.SubstituteTagInlineProcessor, inlinepatterns.LINE_BREAK_RE),
+    'html': (inlinepatterns.HtmlInlineProcessor, inlinepatterns.HTML_RE),
+    'entity': (inlinepatterns.HtmlInlineProcessor, inlinepatterns.ENTITY_RE),
+    'not_strong': (inlinepatterns.SimpleTextInlineProcessor, inlinepatterns.NOT_STRONG_RE),
+    'em_strong': (inlinepatterns.AsteriskProcessor, r'\*'),
+    'em_strong2': (inlinepatterns.UnderscoreProcessor, r'_'),
+}
+
+
+def _is_default_inline_set(registry: Any) -> bool:
+    """ Return `True` if `registry` holds only the unmodified default inline patterns. """
+    try:
+        names = list(registry._data.keys())
+        if len(names) != len(registry) or set(names) - set(_DEFAULT_INLINE_SPEC):
+            return False
+        for name in names:
+            pattern = registry[name]
+            cls, regex = _DEFAULT_INLINE_SPEC[name]
+            if type(pattern) is not cls or getattr(pattern, 'pattern', None) != regex:
+                return False
+        return True
+    except Exception:  # pragma: no cover
+        return False
+
