         else:
             return func(text)
 
+    def render_tokens(self, tokens: Iterable[Dict[str, Any]], state: BlockState) -> str:
+        cls = type(self)
+        if (
+            cls.render_token is not _HTML_RENDER_TOKEN
+            or cls.iter_tokens is not _BASE_ITER_TOKENS
+            or cls._get_method is not _BASE_GET_METHOD
+        ):
+            return super(HTMLRenderer, self).render_tokens(tokens, state)
+
+        getattr_ = object.__getattribute__
+        get_method = self._get_method
+        render_tokens = self.render_tokens
+        out = []
+        append = out.append
+        for token in tokens:
+            name = token["type"]
+            try:
+                func = getattr_(self, name)
+            except AttributeError:
+                func = get_method(name)
+            attrs = token.get("attrs")
+            if "raw" in token:
+                text = token["raw"]
+            elif "children" in token:
+                text = render_tokens(token["children"], state)
+            else:
+                if attrs:
+                    append(func(**attrs))
+                else:
+                    append(func())
+                continue
+            if attrs:
+                append(func(text, **attrs))
+            else:
+                append(func(text))
+        return "".join(out)
+
