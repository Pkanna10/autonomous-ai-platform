+    funcs.append(group_operator)
+    funcs.append(group_comparison)
+    funcs.append(group_as)
+    funcs.append(group_aliased)
+    if ':=' in values:
+        funcs.append(group_assignment)
+    if has_comment:
+        funcs.append(align_comments)
+    funcs.append(group_identifier_list)
+    funcs.append(group_values)
+
+    for func in funcs:
         func(stmt)
     return stmt
 
