+_CATEGORY_CLASSES = {
+    'CATEGORY_DIGIT': r'\d',
+    'CATEGORY_NOT_DIGIT': r'\D',
+    'CATEGORY_SPACE': r'\s',
+    'CATEGORY_NOT_SPACE': r'\S',
+    'CATEGORY_WORD': r'\w',
+    'CATEGORY_NOT_WORD': r'\W',
+}
+
+_ASCII_CHARS = [chr(code) for code in range(128)]
+
+
+class _Unknown(Exception):
+    pass
+
+
+def _chars_matching(class_rx, flags):
+    match = re.compile(class_rx, flags).match
+    return frozenset(c for c in _ASCII_CHARS if match(c))
+
+
+def _first_seq(seq, flags):
+    """Return (set of possible ASCII first chars, nullable) for a sequence.
+
+    Conservative: may over-approximate the set; raises _Unknown if the
+    construct can't be analysed."""
+    result = set()
+    for op, av in seq:
+        chars, nullable = _first_item(op, av, flags)
+        result |= chars
+        if not nullable:
+            return result, False
+    return result, True
+
+
+def _first_item(op, av, flags):
+    name = op.name
+    if name == 'LITERAL':
+        return _chars_matching(re.escape(chr(av)), flags), False
+    if name == 'IN':
+        negate = False
+        parts = []
+        for iop, iav in av:
+            iname = iop.name
+            if iname == 'NEGATE':
+                negate = True
+            elif iname == 'LITERAL':
+                parts.append(re.escape(chr(iav)))
+            elif iname == 'RANGE':
+                parts.append('{}-{}'.format(re.escape(chr(iav[0])),
+                                            re.escape(chr(iav[1]))))
+            elif iname == 'CATEGORY' and iav.name in _CATEGORY_CLASSES:
+                parts.append(_CATEGORY_CLASSES[iav.name])
+            else:
+                raise _Unknown()
+        if not parts:
+            raise _Unknown()
+        class_rx = '[{}{}]'.format('^' if negate else '', ''.join(parts))
+        return _chars_matching(class_rx, flags), False
+    if name == 'BRANCH':
+        result = set()
+        nullable = False
+        for sub in av[1]:
+            chars, sub_nullable = _first_seq(sub, flags)
+            result |= chars
+            nullable = nullable or sub_nullable
+        return result, nullable
+    if name == 'SUBPATTERN':
+        if len(av) != 4 or av[1] or av[2]:
+            raise _Unknown()
+        return _first_seq(av[3], flags)
+    if name in ('MAX_REPEAT', 'MIN_REPEAT', 'POSSESSIVE_REPEAT'):
+        chars, nullable = _first_seq(av[2], flags)
+        return chars, nullable or av[0] == 0
+    if name in ('AT', 'ASSERT', 'ASSERT_NOT'):
+        # zero-width; ignoring the assertion only widens the set
+        return set(), True
+    raise _Unknown()
+
+
+def _first_chars(rx, flags):
+    """Return a frozenset of ASCII characters a match of ``rx`` can start
+    with, or None if this can't be determined (rule always tried)."""
+    if not isinstance(rx, str):
+        return None
+    try:
+        try:
+            from re import _parser as sre_parse
+        except ImportError:
+            import sre_parse
+        parsed = sre_parse.parse(rx, flags)
+        if parsed.state.flags & ~(re.IGNORECASE | re.UNICODE):
+            return None
+        chars, nullable = _first_seq(list(parsed), flags)
+    except Exception:
+        return None
+    if nullable:
+        return None
+    return frozenset(chars)
+
