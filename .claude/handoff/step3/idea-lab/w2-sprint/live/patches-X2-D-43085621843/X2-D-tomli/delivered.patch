+# booleans and decimal integers) with no comments. The match begins right
+# after the opening "[" and ends right after the closing "]".
+_SIMPLE_ARRAY_ELEM_STR: Final = (
+    r"\"[^\"\\\x00-\x08\x0a-\x1f\x7f]*\""
+    r"|'[^'\x00-\x08\x0a-\x1f\x7f]*'"
+    r"|true|false"
+    r"|[+-]?(?:0|[1-9](?:_?[0-9])*)"
+)
+RE_SIMPLE_ARRAY: Final = re.compile(
+    rf"[ \t\n]*(?:(?:{_SIMPLE_ARRAY_ELEM_STR})[ \t\n]*"
+    rf"(?:,[ \t\n]*(?:{_SIMPLE_ARRAY_ELEM_STR})[ \t\n]*)*(?:,[ \t\n]*)?)?\]"
+)
+RE_SIMPLE_ARRAY_ELEM: Final = re.compile(
+    r"\"([^\"\\\x00-\x08\x0a-\x1f\x7f]*)\""
+    r"|'([^'\x00-\x08\x0a-\x1f\x7f]*)'"
+    r"|(true)|(false)"
+    r"|([+-]?(?:0|[1-9](?:_?[0-9])*))"
