+_INLINE_FLAG_CHARS = frozenset('aiLmsux-')
+
+
+def _shift_backrefs(rx, shift):
+    """Return ``rx`` with numeric backreferences shifted by ``shift``.
+
+    Returns None if the pattern contains constructs that cannot be safely
+    combined into an alternation (conditionals, inline global flags,
+    ambiguous escapes)."""
+    if '(?(' in rx:
+        return None
+    if rx.startswith('(?') and len(rx) > 2 and rx[2] in _INLINE_FLAG_CHARS:
+        # Could be a global inline flag group; be conservative.
+        return None
+    out = []
+    i = 0
+    n = len(rx)
+    in_class = False
+    while i < n:
+        c = rx[i]
+        if c == '\\':
+            if i + 1 >= n:
+                return None
+            nxt = rx[i + 1]
+            if nxt in '123456789':
+                if in_class:
+                    return None
+                j = i + 1
+                while j < n and rx[j].isdigit() and j - (i + 1) < 3:
+                    j += 1
+                digits = rx[i + 1:j]
+                if len(digits) > 2:
+                    return None
+                num = int(digits) + shift
+                if num > 99:
+                    return None
+                out.append('(?:\\%d)' % num)
+                i = j
+                continue
+            out.append(rx[i:i + 2])
+            i += 2
+            continue
+        if in_class:
+            if c == ']':
+                in_class = False
+            out.append(c)
+            i += 1
+            continue
+        if c == '[':
+            in_class = True
+            out.append(c)
+            i += 1
+            if i < n and rx[i] == '^':
+                out.append('^')
+                i += 1
+            if i < n and rx[i] == ']':
+                out.append(']')
+                i += 1
+            continue
+        out.append(c)
+        i += 1
+    return ''.join(out)
+
+
+def _build_master(SQL_REGEX, flags):
+    """Build one combined alternation regex from the ordered rules.
+
+    Returns ``(match, actions)`` where ``actions[m.lastindex]`` gives the
+    action of the rule that matched, or None if the rules can't be combined.
+    """
+    try:
+        parts = []
+        actions = [None]
+        base = 0
+        for rx, tt in SQL_REGEX:
+            ngroups = re.compile(rx, flags).groups
+            shifted = _shift_backrefs(rx, base + 1)
+            if shifted is None:
+                return None
+            parts.append('(' + shifted + ')')
+            actions.append(tt)
+            actions.extend([None] * ngroups)
+            base += 1 + ngroups
+        if not parts:
+            return None
+        master = re.compile('|'.join(parts), flags)
+        if master.groups != base:
+            return None
+        return master.match, actions
+    except (re.error, TypeError, ValueError, OverflowError):
+        return None
+
