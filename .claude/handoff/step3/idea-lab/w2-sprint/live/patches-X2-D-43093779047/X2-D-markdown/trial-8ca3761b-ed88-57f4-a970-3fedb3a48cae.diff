+# Required trigger characters of the built-in inline regular expressions. Each regex
+# listed here cannot match unless at least one of its trigger characters is present.
+_REGEX_TRIGGERS: dict[str, frozenset[str]] = {
+    inlinepatterns.BACKTICK_RE: frozenset('`'),
+    inlinepatterns.ESCAPE_RE: frozenset('\\'),
+    inlinepatterns.LINK_RE: frozenset('['),
+    inlinepatterns.IMAGE_LINK_RE: frozenset('!'),
+    inlinepatterns.AUTOLINK_RE: frozenset('<'),
+    inlinepatterns.AUTOMAIL_RE: frozenset('<'),
+    inlinepatterns.LINE_BREAK_RE: frozenset('\n'),
+    inlinepatterns.HTML_RE: frozenset('<'),
+    inlinepatterns.ENTITY_RE: frozenset('&'),
+    inlinepatterns.NOT_STRONG_RE: frozenset('*_'),
+    r'\*': frozenset('*'),
+    r'_': frozenset('_'),
+}
+
+
+def _pattern_triggers(pattern: Any) -> frozenset[str] | None:
+    """
+    Return the set of characters of which at least one must be present for `pattern`
+    to match, or `None` if unknown (the pattern must always be run).
+    """
+    if not isinstance(pattern, inlinepatterns.InlineProcessor):
+        return None
+    if getattr(type(pattern), 'getCompiledRegExp', None) is not inlinepatterns.Pattern.getCompiledRegExp:
+        return None
+    compiled = getattr(pattern, 'compiled_re', None)
+    if not isinstance(compiled, re.Pattern):
+        return None
+    return _REGEX_TRIGGERS.get(compiled.pattern)
+
+
