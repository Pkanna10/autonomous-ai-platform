+def _has_leaf(ttypes, pairs, ttype, values):
+    """Mirror Token.match (non-regex) against a leaf summary."""
+    if values is None:
+        return ttype in ttypes
+    if ttype not in ttypes:
+        return False
+    if isinstance(values, str):
+        values = (values,)
+    if ttype in T.Keyword:
+        return any((ttype, v.upper()) in pairs for v in values)
+    return any((ttype, v) in pairs for v in values)
+
