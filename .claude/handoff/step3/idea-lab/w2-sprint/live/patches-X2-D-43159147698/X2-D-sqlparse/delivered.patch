+                return _ALL, False
+            result |= first
+            nullable = nullable or n
+        return result, nullable
+    if op is sp.MAX_REPEAT or op is sp.MIN_REPEAT:
+        mn, mx, p = av
+        first, n = _seq_first(p)
+        if first is _ALL:
+            return _ALL, False
+        return first, n or mn == 0
+    if op is sp.ASSERT or op is sp.ASSERT_NOT or op is sp.AT:
+        # zero-width: ignoring it only widens the candidate set
+        return set(), True
