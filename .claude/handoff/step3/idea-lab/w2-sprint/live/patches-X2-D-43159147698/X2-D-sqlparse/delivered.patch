+def _in_set(items):
+    """Return set of ASCII chars matched by an IN item list, or _ALL."""
+    negate = False
+    result = set()
+    sp = _sre_parse
+    for op, av in items:
+        if op is sp.NEGATE:
+            negate = True
+        elif op is sp.LITERAL:
+            if av >= 128:
+                return _ALL
+            result.update(c for c in _ASCII if _fold_eq(c, av))
+        elif op is sp.RANGE:
+            lo, hi = av
+            if hi >= 0x100:
+                return _ALL
+            for c in _ASCII:
+                if (lo <= ord(c.lower()) <= hi
+                        or lo <= ord(c.upper()) <= hi):
+                    result.add(c)
+        elif op is sp.CATEGORY:
+            if av is sp.CATEGORY_DIGIT:
+                result.update(c for c in _ASCII if c.isdigit())
+            elif av is sp.CATEGORY_NOT_DIGIT:
+                result.update(c for c in _ASCII if not c.isdigit())
+            elif av is sp.CATEGORY_WORD:
+                result.update(c for c in _ASCII if c.isalnum() or c == '_')
+            elif av is sp.CATEGORY_NOT_WORD:
+                result.update(c for c in _ASCII
+                              if not (c.isalnum() or c == '_'))
+            elif av is sp.CATEGORY_SPACE:
+                result.update(c for c in _ASCII if c.isspace())
+            elif av is sp.CATEGORY_NOT_SPACE:
+                result.update(c for c in _ASCII if not c.isspace())
+            else:
+                return _ALL
+        else:
+            return _ALL
+    if negate:
+        return set(_ASCII) - result
+    return result
+
+
+def _seq_first(seq):
+    """Return (set of possible ASCII first chars or _ALL, nullable)."""
+    result = set()
+    for item in seq:
+        first, nullable = _elem_first(item)
+        if first is _ALL:
+            return _ALL, False
+        result |= first
+        if not nullable:
+            return result, False
+    return result, True
+
+
+def _elem_first(item):
+    sp = _sre_parse
+    op, av = item
+    if op is sp.LITERAL:
+        if av >= 128:
+            return _ALL, False
+        return {c for c in _ASCII if _fold_eq(c, av)}, False
+    if op is sp.NOT_LITERAL:
+        if av >= 128:
+            return _ALL, False
+        return {c for c in _ASCII if not _fold_eq(c, av)}, False
+    if op is sp.IN:
+        s = _in_set(av)
+        return s, False
+    if op is sp.ANY:
+        return _ALL, False
+    if op is sp.SUBPATTERN:
