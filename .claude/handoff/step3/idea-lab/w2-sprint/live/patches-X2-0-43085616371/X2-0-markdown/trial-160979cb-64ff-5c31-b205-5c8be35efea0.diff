+_TRIGGERS: dict[str, str] = {
+    inlinepatterns.BACKTICK_RE: '`',
+    inlinepatterns.ESCAPE_RE: '\\',
+    inlinepatterns.LINK_RE: '[',
+    inlinepatterns.IMAGE_LINK_RE: '![',
+    inlinepatterns.AUTOLINK_RE: '<',
+    inlinepatterns.AUTOMAIL_RE: '<',
+    inlinepatterns.HTML_RE: '<',
+    inlinepatterns.ENTITY_RE: '&',
+    inlinepatterns.LINE_BREAK_RE: '  \n',
+    r'\*': '*',
+    r'_': '_',
+}
+""" Literal substrings every match of the given built-in regex must contain. """
+
+
+def _pattern_trigger(pattern: inlinepatterns.Pattern) -> str | None:
+    """ Return a literal required by every match of `pattern`, or `None` if unknown. """
+    if type(pattern).getCompiledRegExp is not inlinepatterns.Pattern.getCompiledRegExp:
+        return None
+    compiled = getattr(pattern, 'compiled_re', None)
+    if compiled is None or compiled.flags & re.VERBOSE:
+        return None
+    return _TRIGGERS.get(compiled.pattern)
+
