@@ -36,8 +36,20 @@ class HTMLRenderer(BaseRenderer):
         super(HTMLRenderer, self).__init__()
         self._allow_harmful_protocols = allow_harmful_protocols
         self._escape = escape
+        self._plain_text = type(self).text is HTMLRenderer.text
 
     def render_token(self, token: Dict[str, Any], state: BlockState) -> str:
+        # fast path for plain text tokens when ``text`` is not overridden
+        if (
+            token["type"] == "text"
+            and self._plain_text
+            and "raw" in token
+            and not token.get("attrs")
+            and "text" not in self.__dict__
+        ):
+            if self._escape:
+                return escape_text(token["raw"])
+            return safe_entity(token["raw"])
         # backward compitable with v2
         func = self._get_method(token["type"])
         attrs = token.get("attrs")
