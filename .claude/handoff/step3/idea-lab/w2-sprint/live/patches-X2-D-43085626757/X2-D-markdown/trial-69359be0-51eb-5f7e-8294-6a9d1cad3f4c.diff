+    def _build_trigger_re(self) -> re.Pattern[str] | None:
+        """
+        Build a regex matching any character that at least one registered
+        inline pattern requires to match. Return `None` (disabling the fast
+        path) if any registered pattern is not a known built-in.
+        """
+        ip = inlinepatterns
+        known = {
+            'backtick': (ip.BacktickInlineProcessor, ip.BACKTICK_RE, '`'),
+            'escape': (ip.EscapeInlineProcessor, ip.ESCAPE_RE, '\\'),
+            'reference': (ip.ReferenceInlineProcessor, ip.REFERENCE_RE, '['),
+            'link': (ip.LinkInlineProcessor, ip.LINK_RE, '['),
+            'image_link': (ip.ImageInlineProcessor, ip.IMAGE_LINK_RE, '['),
+            'image_reference': (ip.ImageReferenceInlineProcessor, ip.IMAGE_REFERENCE_RE, '['),
+            'short_reference': (ip.ShortReferenceInlineProcessor, ip.REFERENCE_RE, '['),
+            'short_image_ref': (ip.ShortImageReferenceInlineProcessor, ip.IMAGE_REFERENCE_RE, '['),
+            'autolink': (ip.AutolinkInlineProcessor, ip.AUTOLINK_RE, '<'),
+            'automail': (ip.AutomailInlineProcessor, ip.AUTOMAIL_RE, '<'),
+            'linebreak': (ip.SubstituteTagInlineProcessor, ip.LINE_BREAK_RE, '\n'),
+            'html': (ip.HtmlInlineProcessor, ip.HTML_RE, '<'),
+            'entity': (ip.HtmlInlineProcessor, ip.ENTITY_RE, '&'),
+            'not_strong': (ip.SimpleTextInlineProcessor, ip.NOT_STRONG_RE, '*_'),
+            'em_strong': (ip.AsteriskProcessor, r'\*', '*'),
+            'em_strong2': (ip.UnderscoreProcessor, r'_', '_'),
+        }
+        chars = set()
+        try:
+            items = list(self.inlinePatterns._data.items())
+        except AttributeError:  # pragma: no cover
+            return None
+        for name, pattern in items:
+            entry = known.get(name)
+            if entry is None:
+                return None
+            cls, pat, needed = entry
+            if type(pattern) is not cls or getattr(pattern, 'pattern', None) != pat:
+                return None
+            chars.update(needed)
+        if not chars:
+            return None
+        return re.compile('[' + ''.join(re.escape(c) for c in sorted(chars)) + ']')
 
