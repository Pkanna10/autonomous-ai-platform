+def _first_char_test(rx, flags):
+    """Return a callable telling whether a match of ``rx`` could start
+    with a given character, or None if this can't be proven."""
+    try:
+        parsed = _sre_parse.parse(rx, flags)
+        atoms, nullable = _first_seq(list(parsed))
+        if nullable or not atoms:
+            return None
+        test = re.compile('(?:' + '|'.join(atoms) + ')', flags).match
+    except Exception:
+        return None
+    return lambda char: test(char) is not None
