+def _first_elem(op, av):
+    if op in (_sre_c.LITERAL, _sre_c.NOT_LITERAL, _sre_c.ANY, _sre_c.IN):
+        return [_atom_to_regex(op, av)], False
+    if op is _sre_c.SUBPATTERN:
