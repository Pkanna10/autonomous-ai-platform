+def _atom_to_regex(op, av):
+    """Translate a single-character atom to an equivalent regex string."""
+    if op is _sre_c.LITERAL:
+        return _esc_char(av)
+    if op is _sre_c.NOT_LITERAL:
+        return '[^' + _esc_char(av) + ']'
+    if op is _sre_c.ANY:
+        return r'[\s\S]'
+    if op is _sre_c.IN:
+        negate = False
+        parts = []
+        for iop, iav in av:
+            if iop is _sre_c.NEGATE:
+                negate = True
+            elif iop is _sre_c.LITERAL:
+                parts.append(_esc_char(iav))
+            elif iop is _sre_c.RANGE:
+                parts.append(_esc_char(iav[0]) + '-' + _esc_char(iav[1]))
+            elif (iop is _sre_c.CATEGORY
+                  and getattr(iav, 'name', None) in _CATEGORY_ESCAPES):
+                parts.append(_CATEGORY_ESCAPES[iav.name])
+            else:
+                raise _Unprovable
+        if not parts:
+            raise _Unprovable
+        return '[' + ('^' if negate else '') + ''.join(parts) + ']'
+    raise _Unprovable
