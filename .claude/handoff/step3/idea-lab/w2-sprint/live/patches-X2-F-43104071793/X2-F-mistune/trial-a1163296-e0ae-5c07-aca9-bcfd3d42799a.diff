+    def render_tokens(self, tokens: Iterable[Dict[str, Any]], state: BlockState) -> str:
+        cls = type(self)
+        if cls.render_token is not HTMLRenderer.render_token or cls.iter_tokens is not BaseRenderer.iter_tokens:
+            return super(HTMLRenderer, self).render_tokens(tokens, state)
+
+        get_method = self._get_method
+        cache: Dict[str, Any] = {}
+        out = []
+        append = out.append
+        for token in tokens:
+            name = token["type"]
+            func = cache.get(name)
+            if func is None:
+                func = get_method(name)
+                cache[name] = func
+            attrs = token.get("attrs")
+            if "raw" in token:
+                text = token["raw"]
+            elif "children" in token:
+                text = self.render_tokens(token["children"], state)
+            else:
+                if attrs:
+                    append(func(**attrs))
+                else:
+                    append(func())
+                continue
+            if attrs:
+                append(func(text, **attrs))
+            else:
+                append(func(text))
