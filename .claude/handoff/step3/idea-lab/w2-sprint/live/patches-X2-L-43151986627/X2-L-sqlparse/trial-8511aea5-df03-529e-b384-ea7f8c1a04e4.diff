+class _AnyChar(Exception):
+    """Raised when the first-char set of a pattern can't be bounded."""
+
+
+_CATEGORY_CLASS = {}
+for _name, _cls in (('CATEGORY_DIGIT', '\\d'), ('CATEGORY_NOT_DIGIT', '\\D'),
+                    ('CATEGORY_SPACE', '\\s'), ('CATEGORY_NOT_SPACE', '\\S'),
+                    ('CATEGORY_WORD', '\\w'), ('CATEGORY_NOT_WORD', '\\W')):
+    _c = getattr(_sre_parse, _name, None)
+    if _c is not None:
+        _CATEGORY_CLASS[_c] = _cls
+
+
+def _chr_esc(code):
+    return '\\U%08x' % code
+
+
+def _first_items(seq, out):
+    """Collect char-class items that may start a match of ``seq`` into
+    ``out``. Returns True if ``seq`` may match the empty string.
+    Raises _AnyChar if unsure."""
+    sp = _sre_parse
+    repeats = tuple(getattr(sp, n) for n in
+                    ('MAX_REPEAT', 'MIN_REPEAT', 'POSSESSIVE_REPEAT')
+                    if hasattr(sp, n))
+    atomic = getattr(sp, 'ATOMIC_GROUP', None)
+    for op, av in seq:
+        if op is sp.LITERAL:
+            out.append(_chr_esc(av))
+            return False
+        elif op is sp.IN:
+            for iop, iav in av:
+                if iop is sp.LITERAL:
+                    out.append(_chr_esc(iav))
+                elif iop is sp.RANGE:
+                    out.append(_chr_esc(iav[0]) + '-' + _chr_esc(iav[1]))
+                elif iop is sp.CATEGORY and iav in _CATEGORY_CLASS:
+                    out.append(_CATEGORY_CLASS[iav])
+                else:
+                    raise _AnyChar
+            return False
+        elif op is sp.SUBPATTERN:
+            if len(av) == 4 and (av[1] or av[2]):
+                raise _AnyChar
+            if not _first_items(av[-1], out):
+                return False
+        elif atomic is not None and op is atomic:
+            if not _first_items(av, out):
+                return False
+        elif op is sp.BRANCH:
+            nullable = False
+            for alt in av[1]:
+                if _first_items(alt, out):
+                    nullable = True
+            if not nullable:
+                return False
+        elif op in repeats:
+            lo, _hi, item = av
+            if not _first_items(item, out) and lo > 0:
+                return False
+        elif op is sp.AT or op is sp.ASSERT or op is sp.ASSERT_NOT:
+            # zero-width; ignoring it only enlarges the first-char set
+            continue
+        else:
+            raise _AnyChar
+    return True
+
+
+def _first_char_matcher(rx, flags):
+    """Return a match function telling whether a character could start a
+    match of ``rx``, or None if that can't be determined safely."""
+    if not isinstance(rx, str):
+        return None
+    try:
+        parsed = _sre_parse.parse(rx, flags)
+        if re.compile(rx, flags).flags != re.compile('', flags).flags:
+            return None
+        items = []
+        if _first_items(list(parsed), items) or not items:
+            return None
+        return re.compile('[' + ''.join(items) + ']', flags).match
+    except Exception:
+        return None
+
 
