+            aset = _atom_set(s[i:j], flags)
+            anull = False
+        elif ch in '.^$*+?{}]':
+            raise _Unknown
+        else:
+            j = i + 1
+            aset = _atom_set(re.escape(ch), flags)
+            anull = False
