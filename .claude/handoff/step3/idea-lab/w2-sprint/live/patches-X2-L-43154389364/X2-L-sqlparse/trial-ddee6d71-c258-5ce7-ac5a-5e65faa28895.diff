+def _atom_set(atom, flags):
+    """ASCII characters matched by a single-character atom."""
+    rx = re.compile(atom, flags)
+    return {c for c in _ASCII_CHARS if rx.fullmatch(c)}
+
+
+def _first_chars(pattern, flags):
+    """Return the set of ASCII characters a match of ``pattern`` can start
+    with, or None if this can't be determined safely (or the pattern may
+    match the empty string)."""
+    if flags & re.VERBOSE:
+        return None
+    try:
+        result, nullable, end = _fc_alts(pattern, 0, flags)
+    except (_Unknown, IndexError, re.error):
+        return None
+    if end != len(pattern) or nullable:
+        return None
+    return frozenset(result)
+
+
+def _fc_alts(s, i, flags):
+    """Parse alternatives until ')' or end. Returns (set, nullable, idx)."""
+    total = set()
+    any_nullable = False
+    while True:
+        fs, nullable, i = _fc_seq(s, i, flags)
+        total |= fs
+        any_nullable = any_nullable or nullable
+        if i < len(s) and s[i] == '|':
+            i += 1
+            continue
+        return total, any_nullable, i
+
+
+def _skip_to_alt_end(s, i):
+    """Skip the rest of a sequence, stopping at '|' or ')' at depth 0."""
+    depth = 0
+    n = len(s)
+    while i < n:
+        ch = s[i]
+        if ch == '\\':
+            i += 2
+            continue
+        if ch == '[':
+            i = _class_end(s, i)
+            continue
+        if ch == '(':
+            depth += 1
+        elif ch == ')':
+            if depth == 0:
+                return i
+            depth -= 1
+        elif ch == '|' and depth == 0:
+            return i
+        i += 1
+    if depth:
+        raise _Unknown
+    return i
+
+
+def _class_end(s, i):
+    """Index after the character class starting at s[i] == '['."""
+    j = i + 1
+    if s[j] == '^':
+        j += 1
+    if s[j] == ']':
+        j += 1
+    while s[j] != ']':
+        if s[j] == '\\':
+            j += 2
+        elif s[j] == '[':
+            raise _Unknown
+        else:
+            j += 1
+    return j + 1
+
+
+def _fc_seq(s, i, flags):
+    total = set()
+    n = len(s)
+    while True:
+        if i >= n or s[i] in '|)':
+            return total, True, i
+        ch = s[i]
+        if ch == '(':
+            if i + 1 < n and s[i + 1] == '?':
+                if s[i + 2] != ':':
+                    raise _Unknown
+                start = i + 3
+            else:
+                start = i + 1
+            aset, anull, j = _fc_alts(s, start, flags)
+            if j >= n or s[j] != ')':
+                raise _Unknown
+            j += 1
+        elif ch == '[':
+            j = _class_end(s, i)
+            aset = _atom_set(s[i:j], flags)
+            anull = False
+        elif ch == '\\':
+            nxt = s[i + 1]
