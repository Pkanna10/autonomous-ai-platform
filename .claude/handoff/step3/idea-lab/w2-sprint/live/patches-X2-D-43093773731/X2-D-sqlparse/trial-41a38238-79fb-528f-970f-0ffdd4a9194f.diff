+def _class_fragment(items):
+    parts = []
+    negate = ''
+    for op, av in items:
+        if op is _sre_parse.NEGATE:
+            negate = '^'
+        elif op is _sre_parse.LITERAL:
+            parts.append(re.escape(chr(av)))
+        elif op is _sre_parse.RANGE:
+            lo, hi = av
+            parts.append(re.escape(chr(lo)) + '-' + re.escape(chr(hi)))
+        elif op is _sre_parse.CATEGORY and av in _CATEGORY_CLASSES:
+            parts.append(_CATEGORY_CLASSES[av])
+        else:
+            raise _UnknownFirst
+    if not parts:
+        raise _UnknownFirst
+    return '[' + negate + ''.join(parts) + ']'
+
+
+def _first_fragments(seq):
+    """Return (fragments, nullable) for a parsed subpattern sequence.
+
+    ``fragments`` are single-character regex fragments; the sequence can
+    only start matching with a character matched by one of them, unless
+    ``nullable`` is True (it may match the empty string)."""
+    P = _sre_parse
+    frags = []
+    for op, av in seq:
+        if op is P.LITERAL:
+            frags.append(re.escape(chr(av)))
+            return frags, False
+        elif op is P.NOT_LITERAL:
+            frags.append('[^' + re.escape(chr(av)) + ']')
+            return frags, False
+        elif op is P.IN:
+            frags.append(_class_fragment(av))
+            return frags, False
+        elif op is P.SUBPATTERN:
+            _group, add_flags, del_flags, sub = av
+            if add_flags or del_flags:
+                raise _UnknownFirst
+            sub_frags, nullable = _first_fragments(sub)
+            frags.extend(sub_frags)
+            if not nullable:
+                return frags, False
+        elif op is P.BRANCH:
+            any_nullable = False
+            for sub in av[1]:
+                sub_frags, nullable = _first_fragments(sub)
+                frags.extend(sub_frags)
+                any_nullable = any_nullable or nullable
+            if not any_nullable:
+                return frags, False
+        elif op in (P.MAX_REPEAT, P.MIN_REPEAT):
+            lo, hi, sub = av
+            if hi == 0:
+                continue
+            sub_frags, nullable = _first_fragments(sub)
+            frags.extend(sub_frags)
+            if lo > 0 and not nullable:
+                return frags, False
+        elif op in (P.ASSERT, P.ASSERT_NOT, P.AT):
+            # zero-width: only restricts matches, skipping is conservative
+            continue
+        else:
+            raise _UnknownFirst
+    return frags, True
+
+
+def _first_char_matcher(rx, flags):
+    """Return a predicate telling whether a match of ``rx`` may start with
+    a given character, or None if this cannot be determined."""
+    try:
+        parsed = _sre_parse.parse(rx, flags)
+        frags, nullable = _first_fragments(list(parsed))
+        if nullable or not frags:
+            return None
+        first = re.compile('(?:' + '|'.join(frags) + ')', flags).fullmatch
+    except Exception:
+        return None
+    return lambda char: first(char) is not None
+
 
