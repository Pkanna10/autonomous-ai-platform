+    # Literal substrings each built-in regex requires in every match; used to
+    # skip patterns which cannot possibly match the current text.
+    _triggers = {
+        'backtick': ('`',),
+        'escape': ('\\',),
+        'reference': ('[',),
+        'link': ('[',),
+        'image_link': ('![',),
+        'image_reference': ('![',),
+        'short_reference': ('[',),
+        'short_image_ref': ('![',),
+        'autolink': ('<',),
+        'automail': ('<',),
+        'linebreak': ('  \n',),
+        'html': ('<',),
+        'entity': ('&',),
+        'not_strong': ('*', '_'),
+        'em_strong': ('*',),
+        'em_strong2': ('_',),
+    }
+    for _name, _trig in _triggers.items():
+        inlinePatterns[_name].TRIGGERS = _trig
     return inlinePatterns
 
 
