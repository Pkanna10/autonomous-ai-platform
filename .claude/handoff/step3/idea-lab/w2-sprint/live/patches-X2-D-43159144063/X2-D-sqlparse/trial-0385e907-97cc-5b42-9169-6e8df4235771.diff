+_TRIGGER_KEYWORDS = frozenset((
+    'CASE', 'IF', 'FOR', 'FOREACH', 'BEGIN', 'OVER', 'VALUES', 'TIMESTAMP'))
+
+
+def _scan_triggers(stmt):
+    """Record which pass-triggering leaf tokens occur in the statement.
+
+    Leaf values and ttypes (except Wildcard -> Operator) never change during
+    grouping, so passes whose trigger tokens are absent cannot fire.
+    """
+    kws = set()
+    has_bracket = has_typecast = has_assign = has_builtin = False
+    has_comment = has_order = has_tzcast = False
+    T_Keyword = T.Keyword
+    T_Punct = T.Punctuation
+    T_Assign = T.Assignment
+    T_Builtin = T.Name.Builtin
+    T_Comment = T.Comment
+    T_Order = T.Keyword.Order
+    T_TZCast = T.Keyword.TZCast
+    for tok in stmt.flatten():
+        tt = tok.ttype
+        if tt is T_Keyword:
+            v = tok.normalized
+            if v in _TRIGGER_KEYWORDS:
+                kws.add(v)
+        elif tt is T_Punct:
+            v = tok.value
+            if v == '[':
+                has_bracket = True
+            elif v == '::':
+                has_typecast = True
+        elif tt is T_Assign:
+            if tok.value == ':=':
+                has_assign = True
+        elif tt is T_Builtin:
+            has_builtin = True
+        elif tt is None:
+            continue
+        else:
+            if tt in T_Comment:
+                has_comment = True
+            if tt in T_Order:
+                has_order = True
+            if tt == T_TZCast:
+                has_tzcast = True
+    return (kws, has_bracket, has_typecast, has_assign, has_builtin,
+            has_comment, has_order, has_tzcast)
+
+
