+
+    _BACKREF_RE = re.compile(r'(?<!\\)((?:\\\\)*)\\([1-9][0-9]?)')
+
+    def _build_master(self, SQL_REGEX, flags):
+        """Combine all rules into one ordered alternation pattern.
+
+        Each rule is wrapped in its own capturing group; numbered
+        backreferences inside rules are renumbered accordingly.  Falls
+        back to the sequential rule loop if combining is not possible.
+        """
+        self._master_match = None
+        self._master_actions = None
+        parts = []
+        actions = {}
+        group_count = 0
+        try:
+            for rx, tt in SQL_REGEX:
+                inner_groups = re.compile(rx, flags).groups
+                # named groups / global inline flags / octal escapes:
+                # keep the safe sequential path
+                if ('(?P' in rx or re.search(r'\(\?[aiLmsux]+\)', rx)
+                        or re.search(r'\\[0-7]{3}', rx)):
+                    return
+                offset = group_count + 1  # wrapper group index
+
+                def _renum(m, offset=offset):
+                    return '{}\\{}(?:)'.format(
+                        m.group(1), int(m.group(2)) + offset)
+
+                rx2 = self._BACKREF_RE.sub(_renum, rx)
+                parts.append('({})'.format(rx2))
+                actions[offset] = tt
+                group_count += 1 + inner_groups
+            master = re.compile('|'.join(parts), flags)
+        except (re.error, RecursionError, OverflowError):
+            return
+        if master.groups != group_count:
+            return
+        self._master_match = master.match
+        self._master_actions = actions
 
