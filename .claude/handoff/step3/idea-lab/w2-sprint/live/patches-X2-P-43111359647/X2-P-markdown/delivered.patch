+# Map of known inline regex sources to characters, at least one of which must
+# be present in the text for the regex to match anywhere in it.
+_PATTERN_TRIGGERS: dict[str, tuple[str, ...]] = {
+    inlinepatterns.BACKTICK_RE: ('`',),
+    inlinepatterns.ESCAPE_RE: ('\\',),
+    inlinepatterns.LINK_RE: ('[',),
+    inlinepatterns.IMAGE_LINK_RE: ('[',),
+    inlinepatterns.AUTOLINK_RE: ('<',),
+    inlinepatterns.AUTOMAIL_RE: ('<',),
+    inlinepatterns.HTML_RE: ('<',),
+    inlinepatterns.ENTITY_RE: ('&',),
+    inlinepatterns.LINE_BREAK_RE: ('\n',),
+    inlinepatterns.NOT_STRONG_RE: ('*', '_'),
+    inlinepatterns.EM_STRONG_RE: ('*',),
+    inlinepatterns.EM_STRONG2_RE: ('_',),
+    r'\*': ('*',),
+    r'_': ('_',),
+}
+
+
+def _pattern_triggers(pattern: Any) -> tuple[str, ...] | None:
+    """ Return trigger characters for a new-style pattern with a known regex, else `None`. """
+    if not isinstance(pattern, inlinepatterns.InlineProcessor):
+        return None
+    try:
+        source = pattern.getCompiledRegExp().pattern
+    except Exception:  # pragma: no cover
+        return None
+    if not isinstance(source, str):  # pragma: no cover
+        return None
+    return _PATTERN_TRIGGERS.get(source)
+
